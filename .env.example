# SQLite (dev)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production, via docker-compose)
# DATABASE_URL="postgresql://netinventory:netinventory@localhost:5432/netinventory?schema=public"

# Segredo para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=""

# IA (opcional): a chave da OpenAI é cadastrada em Configurações (fica criptografada no banco).
# Sem chave cadastrada, os recursos de IA ficam desativados. Modelo padrão, se não for escolhido na tela:
OPENAI_MODEL="gpt-5.4-mini"
