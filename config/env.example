# SQLite (dev)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production, via docker-compose)
# DATABASE_URL="postgresql://netinventory:netinventory@localhost:5432/netinventory?schema=public"

# Segredo para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=""

# IA (opcional): configurada via interface em Configurações (fica criptografada no banco).
# Suporta: Google Gemini (grátis no Google AI Studio, igual ao MistakeMap),
# OpenRouter (com modelos gratuitos :free), Groq, Ollama (local/offline) e OpenAI.
# Sem IA configurada, os recursos inteligentes ficam desativados.
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-2.5-flash"
