# Copie para tools/harness2/.env (o .env nunca vai para o Git).
#
# Modelos no formato provedor/modelo do OpenCode. O padrão usa o Gemini do Google AI Studio,
# o mesmo provedor que o painel já usa: crie a chave em https://aistudio.google.com/apikey
HARNESS2_SOLVER_MODEL=google/gemini-2.5-flash
# Editor/compositor do harness; vazio usa o mesmo do executor.
HARNESS2_IMPROVER_MODEL=google/gemini-2.5-pro
GOOGLE_GENERATIVE_AI_API_KEY=

# Outras opções (troque os modelos acima):
#   OpenRouter: HARNESS2_SOLVER_MODEL=openrouter/<modelo> e OPENROUTER_API_KEY=
#   Vertex AI:  HARNESS2_SOLVER_MODEL=google-vertex/<modelo>, GOOGLE_CLOUD_PROJECT=
#               e `gcloud auth application-default login`

# Opcionais
# NI_HARNESS2_BASE_REF=HEAD        commit em que as tarefas partem
# NI_HARNESS2_TIMEOUT=1800         segundos por execução do agente
# HARNESS2_RUNS_DIR=               padrão: tools/harness2/runs
