@page "/console/access-denied"
@attribute [AllowAnonymous]
<PageTitle>Acesso restrito · NetInventory</PageTitle>
<section class="panel login-panel">
    <div class="eyebrow">Permissões da conta</div>
    <h1>Acesso restrito</h1>
    <p class="muted">Sua conta não tem permissão para abrir esta área. Um administrador pode consultar a configuração e o cadastro de agentes.</p>
    <div class="actions"><a class="button primary" href="/">Voltar à visão geral</a><a class="button" href="/sign-in">Entrar com outra conta</a></div>
</section>
