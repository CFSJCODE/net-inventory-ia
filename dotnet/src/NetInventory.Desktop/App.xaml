<Application x:Class="NetInventory.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <!-- Panel green as the accent (radio buttons, check boxes, focus, progress) instead of the Windows accent. -->
   <Color x:Key="SystemAccentColor">#00C950</Color>
   <Color x:Key="SystemAccentColorLight1">#00C950</Color>
   <Color x:Key="SystemAccentColorLight2">#00C950</Color>
   <Color x:Key="SystemAccentColorLight3">#3DDC7A</Color>
   <Color x:Key="SystemAccentColorDark1">#00A944</Color>
   <Color x:Key="SystemAccentColorDark2">#008A38</Color>
   <Color x:Key="SystemAccentColorDark3">#006B2B</Color>
  </ResourceDictionary>
 </Application.Resources>
</Application>
