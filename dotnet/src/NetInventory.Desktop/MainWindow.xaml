<Window x:Class="NetInventory.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NetInventory.Desktop" Title="NetInventory — painel técnico">
 <NavigationView x:Name="Navigation" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneTitle="NetInventory" OpenPaneLength="224" SelectionChanged="Navigation_SelectionChanged">
  <NavigationView.Resources>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
   <Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </NavigationView.Resources>
  <NavigationView.MenuItems>
   <NavigationViewItem x:Name="OverviewNav" Content="Visão geral" Icon="Home" Tag="overview"/><NavigationViewItem Content="Dispositivos" Icon="AllApps" Tag="inventory"/><NavigationViewItemSeparator/><NavigationViewItem Content="Conexão" Icon="Setting" Tag="connection"/>
  </NavigationView.MenuItems>
  <NavigationView.PaneFooter><TextBlock Text="Agente Windows · .NET" Margin="16" Style="{StaticResource Secondary}"/></NavigationView.PaneFooter>
  <Grid x:Name="RootGrid" Padding="24" RowSpacing="16" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Estado da coleta e inventário dos computadores gerenciados." Style="{StaticResource Secondary}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="Loading" Width="24" Height="24" IsActive="False"/><Button x:Name="RefreshButton" Content="Atualizar" Click="Refresh_Click" IsEnabled="False"/></StackPanel></Grid>
   <InfoBar x:Name="ConnectionStatus" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="Aguardando conexão" Message="Configure o servidor na seção Conexão."/>
   <ScrollViewer x:Name="OverviewView" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
    <Grid x:Name="MetricsGrid" ColumnSpacing="16" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="TotalCard" Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="Computadores cadastrados" Style="{StaticResource Secondary}"/><TextBlock x:Name="TotalValue" Text="—" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Identidades persistentes do agente" Style="{StaticResource Secondary}"/></StackPanel></Border>
     <Border x:Name="RecentCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="Coletas recentes" Style="{StaticResource Secondary}"/><TextBlock x:Name="RecentValue" Text="—" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Amostras com até 5 minutos" Style="{StaticResource Secondary}"/></StackPanel></Border>
     <Border x:Name="StaleCard" Grid.Column="2" Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="Antigas / pendentes" Style="{StaticResource Secondary}"/><TextBlock x:Name="StaleValue" Text="—" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Exigem verificação da coleta" Style="{StaticResource Secondary}"/></StackPanel></Border>
     <Border x:Name="SessionsCard" Grid.Column="3" Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="Sessões ativas observadas" Style="{StaticResource Secondary}"/><TextBlock x:Name="SessionsValue" Text="—" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Console / RDP nas últimas amostras" Style="{StaticResource Secondary}"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="Estado do servidor" FontSize="20" FontWeight="SemiBold"/><StackPanel x:Name="ServerSummary" Spacing="8"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="Atenção operacional" FontSize="20" FontWeight="SemiBold"/><StackPanel x:Name="AttentionPanel" Spacing="8"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="Últimas coletas por computador" FontSize="20" FontWeight="SemiBold"/><ListView x:Name="OverviewDevices" SelectionMode="None" HorizontalContentAlignment="Stretch"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Grid x:Name="InventoryView" Grid.Row="2" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" PlaceholderText="Buscar por nome, IP, MAC, SO, fabricante ou usuário" TextChanged="Search_Changed"/><ComboBox x:Name="RecencyFilter" Grid.Column="1" Width="200" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todas as coletas"/><ComboBoxItem Content="Recentes"/><ComboBoxItem Content="Antigas"/><ComboBoxItem Content="Aguardando coleta"/></ComboBox></Grid>
    <Grid x:Name="InventorySplit" Grid.Row="1" ColumnSpacing="16" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition x:Name="InventoryListColumn" Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="InventoryListRow" Height="*"/><RowDefinition x:Name="InventoryDetailRow" Height="0"/></Grid.RowDefinitions>
     <Border x:Name="InventoryListBorder" Style="{StaticResource Card}" Padding="8"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="FilterSummary" Text="Nenhum computador carregado" Margin="8" Style="{StaticResource Secondary}"/><ListView x:Name="Devices" Grid.Row="1" SelectionChanged="Device_Selected" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="local:InventoryRow"><StackPanel Spacing="8" Padding="8"><TextBlock Text="{x:Bind Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind TypeAndRecency}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Address}" Style="{StaticResource Secondary}"/><TextBlock Text="{x:Bind OperatingSystem}" TextTrimming="CharacterEllipsis" Style="{StaticResource Secondary}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
     <Border x:Name="DetailBorder" Grid.Column="1" Style="{StaticResource Card}"><Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="8"><TextBlock x:Name="DetailTitle" Text="Selecione um computador" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DetailSubtitle" Text="Sistema, hardware, rede, sessões e proveniência da coleta." Style="{StaticResource Secondary}"/></StackPanel>
      <TabView Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
       <TabViewItem Header="Sistema" IsClosable="False"><ScrollViewer><StackPanel x:Name="SystemFields" Spacing="16" Padding="0,16,8,16"/></ScrollViewer></TabViewItem><TabViewItem Header="Hardware" IsClosable="False"><ScrollViewer><StackPanel x:Name="HardwareFields" Spacing="16" Padding="0,16,8,16"/></ScrollViewer></TabViewItem><TabViewItem Header="Rede" IsClosable="False"><ScrollViewer><StackPanel x:Name="NetworkFields" Spacing="16" Padding="0,16,8,16"/></ScrollViewer></TabViewItem><TabViewItem Header="Sessões" IsClosable="False"><ScrollViewer><StackPanel x:Name="SessionFields" Spacing="16" Padding="0,16,8,16"/></ScrollViewer></TabViewItem><TabViewItem Header="Coleta" IsClosable="False"><ScrollViewer><StackPanel x:Name="CollectionFields" Spacing="16" Padding="0,16,8,16"/></ScrollViewer></TabViewItem>
      </TabView></Grid></Border>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="ConnectionView" Grid.Row="2" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
    <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="Servidor de inventário" FontSize="20" FontWeight="SemiBold"/><TextBox x:Name="ServerAddress" Header="Endereço do servidor" Text="https://localhost:7444"/><PasswordBox x:Name="AdminCredential" Header="Credencial de administração"/><CheckBox x:Name="LocalDevelopment" Content="Permitir HTTP somente em localhost para desenvolvimento"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConnectButton" Content="Conectar" Click="Connect_Click"/><Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect_Click" IsEnabled="False"/></StackPanel><TextBlock Text="A credencial permanece mascarada e não é incluída nas informações técnicas exibidas." Style="{StaticResource Secondary}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="Diagnóstico da conexão" FontSize="20" FontWeight="SemiBold"/><StackPanel x:Name="ConnectionDiagnostics" Spacing="8"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </NavigationView>
</Window>
