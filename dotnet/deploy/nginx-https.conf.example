# Substitua EXAMPLE_DOMAIN e os caminhos de certificado. Valide nginx -t antes de ativar.
# Instale em /etc/nginx/sites-available/netinventory-dotnet; habilitacao e TLS sao explicitos.
server {
    listen 443 ssl;
    server_name EXAMPLE_DOMAIN;
    ssl_certificate /etc/netinventory-dotnet/tls/fullchain.pem;
    ssl_certificate_key /etc/netinventory-dotnet/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 512k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:7444;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
}
