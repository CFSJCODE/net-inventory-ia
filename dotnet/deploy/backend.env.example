# LAN privada: painel em http://IP_PRIVADO_DO_LINUX:3000/.
# Somente para IPv4 RFC1918; HTTP publico permanece recusado pelo backend.
# Instalar fora do repositorio, modo 0600. O instalador gera credenciais aleatorias.
ASPNETCORE_URLS=http://0.0.0.0:3000
ASPNETCORE_ENVIRONMENT=Production
Inventory__AllowPrivateLanHttp=true
Inventory__AllowLoopbackHttp=true
Inventory__DataDirectory=/var/lib/netinventory-dotnet
Inventory__HostProfilePath=/var/lib/netinventory-dotnet/host-profile.local.json
Inventory__AdminToken=GENERATE_RANDOM_TOKEN_LOCALLY
Inventory__BootstrapUsername=admin
Inventory__BootstrapPassword=GENERATE_RANDOM_PASSWORD_LOCALLY
# Internet: use o modelo nginx HTTPS, ouvindo apenas http://127.0.0.1:7444 no backend.
# Inventory__AllowPrivateLanHttp=false
# Inventory__TrustLoopbackProxy=true
