# NetInventory na LAN: painel na porta 80 (http://netinventory.local ou http://192.168.0.50)
# Encaminha para o host .NET em 127.0.0.1:3000. Os agentes continuam usando a porta 3000 direto.
#
# Instalacao no Ubuntu:
#   sudo cp nginx-lan.conf.example /etc/nginx/sites-available/netinventory
#   sudo ln -sf /etc/nginx/sites-available/netinventory /etc/nginx/sites-enabled/netinventory
#   sudo rm -f /etc/nginx/sites-enabled/default
#   crie /etc/nginx/conf.d/netinventory-upgrade-map.conf com o bloco abaixo (fora de server):
#     map $http_upgrade $connection_upgrade {
#         default upgrade;
#         ''      '';
#     }
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow from 192.168.0.0/24 to any port 80 proto tcp
#
# No /etc/netinventory-dotnet/backend.env, sem porta no nome, para o redirecionamento cair na 80:
#   Inventory__BrowserHost=netinventory.local
#   Inventory__TrustLoopbackProxy=true
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name netinventory.local _;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
